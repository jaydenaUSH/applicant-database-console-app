{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=internDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": { "Default": "Verbose" },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../../../log/rollingLog.log",
          "rollingInterval": "Infinite",
          "fileSizeLimitBytes": 1048576,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 10,
          "outputTemplate": "Timestamp: {Timestamp:yyyy-MM-dd HH:mm:ss zzz}{NewLine}Category: {SourceContext}{NewLine}Message: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}